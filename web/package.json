{
	"name": "@tactica/web",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "tsc -b && vite build",
		"dev": "vite",
		"fmt": "oxfmt . '!src/routeTree.gen.ts'",
		"fmt-check": "oxfmt --check . '!src/routeTree.gen.ts'",
		"lint": "oxlint .",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@tanstack/react-query": "^5.90.5",
		"@tanstack/react-router": "^1.131.29",
		"react": "^19.1.1",
		"react-dom": "^19.1.1"
	},
	"devDependencies": {
		"@tanstack/router-plugin": "^1.131.29",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.0",
		"@types/node": "^24.10.1",
		"@types/react": "^19.1.16",
		"@types/react-dom": "^19.1.9",
		"@vitejs/plugin-react": "^5.1.1",
		"jsdom": "^27.0.1",
		"oxlint": "^1.77.0",
		"typescript": "^5.9.3",
		"vite": "^7.1.12",
		"vitest": "^3.2.4"
	}
}
